# Sao chép file này thành .env và điền giá trị thực
# KHÔNG commit file .env lên git

AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name
AZURE_STORAGE_CONTAINER_NAME=secure-files
AZURE_KEY_VAULT_URL=https://your-keyvault.vault.azure.net/
# Không cần connection string — dùng Managed Identity / DefaultAzureCredential

# CORS: danh sách domain frontend, cách nhau bằng dấu phẩy
ALLOWED_ORIGINS=http://localhost:5173,https://your-fe.up.railway.app

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Thuật toán: HS256 (dev) hoặc RS256/ES256 (production)
JWT_ALGORITHM=HS256

# HS256: đặt chuỗi bí mật đủ dài (>= 32 ký tự)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# RS256/ES256: đường dẫn file PEM hoặc nội dung inline
# JWT_PUBLIC_KEY=/path/to/public.pem

# Issuer và Audience (tuỳ IdP — bỏ trống nếu không cần check)
JWT_ISSUER=
JWT_AUDIENCE=

# Cho phép lệch đồng hồ tối đa (giây)
JWT_LEEWAY_SECONDS=10

# ── Token expiry ──────────────────────────────────────────────────────────────
# Access token: short-lived (minutes). Recommend 15 prod / 60 dev.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token: long-lived (days). Stored in httpOnly cookie.
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Cookie security ───────────────────────────────────────────────────────────
# true  → Secure + SameSite=Strict (dùng khi có HTTPS)
# false → SameSite=Lax (localhost dev)
COOKIE_SECURE=false

# ── PostgreSQL (asyncpg driver) ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/secure_file_sharing
# Bật SQL log khi debug: DB_ECHO=true
DB_ECHO=false
