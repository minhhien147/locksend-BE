# Sao chép file này thành .env và điền giá trị thực
# KHÔNG commit file .env lên git

AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name
AZURE_STORAGE_CONTAINER_NAME=secure-files
AZURE_KEY_VAULT_URL=https://your-keyvault.vault.azure.net/
# Không cần connection string — dùng Managed Identity / DefaultAzureCredential

# Kho lưu trữ cá nhân: hạn mức bytes mỗi user (mặc định 5GB)
# STORAGE_QUOTA_BYTES=5368709120

# CORS: danh sách domain frontend, cách nhau bằng dấu phẩy
# Railway FE: https://your-fe.up.railway.app
ALLOWED_ORIGINS=http://localhost:5173,https://your-fe.up.railway.app

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Thuật toán: HS256 (dev) hoặc RS256/ES256 (production)
JWT_ALGORITHM=HS256

# HS256: đặt chuỗi bí mật đủ dài (>= 32 ký tự)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# RS256/ES256: đường dẫn file PEM hoặc nội dung inline
# JWT_PUBLIC_KEY=/path/to/public.pem

# Issuer và Audience (tuỳ IdP — bỏ trống nếu không cần check)
JWT_ISSUER=
JWT_AUDIENCE=

# Cho phép lệch đồng hồ tối đa (giây)
JWT_LEEWAY_SECONDS=10

# ── Token expiry ──────────────────────────────────────────────────────────────
# Access token: short-lived (minutes). Recommend 15 prod / 60 dev.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token: long-lived (days). Stored in httpOnly cookie.
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Cookie security ───────────────────────────────────────────────────────────
# Local: COOKIE_SECURE=false (SameSite=Lax mặc định)
# FE + BE khác domain (Railway): COOKIE_SECURE=true, COOKIE_SAMESITE=none
COOKIE_SECURE=false
# COOKIE_SAMESITE=none
# Mặc định false: refresh cookie là session cookie → đóng trình duyệt là logout.
# true: cookie sống theo REFRESH_TOKEN_EXPIRE_DAYS (giữ đăng nhập qua nhiều phiên).
REFRESH_COOKIE_PERSIST=false

# ── PostgreSQL (asyncpg driver) ───────────────────────────────────────────────
# Local:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/secure_file_sharing
# Connection pool là PER WORKER: tổng = WEB_CONCURRENCY × (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_RECYCLE=1800
# Số uvicorn worker (start.sh). Railway free vCPU chia sẻ → 2 là hợp lý
# WEB_CONCURRENCY=2
# ACCESS_LOG=false để tắt access log của uvicorn khi chạy load test
# TokenAccessLog ghi bằng worker nền (gom theo lô, không nằm trong request path)
# TOKEN_ACCESS_LOG_QUEUE_SIZE=5000
# TOKEN_ACCESS_LOG_BATCH_SIZE=50
# TOKEN_ACCESS_LOG_USER_CACHE_TTL=300
# Railway: thêm Postgres plugin → copy DATABASE_URL (postgresql://… tự đổi sang +asyncpg)
# Bắt buộc trên Railway: DATABASE_URL, JWT_SECRET, ALLOWED_ORIGINS, AZURE_*, COOKIE_SECURE=true, COOKIE_SAMESITE=none
# Bật SQL log khi debug: DB_ECHO=true
DB_ECHO=false

# ── LockSend AI (monorepo: locksend-ai/ ở root repo) ───────────────────────────
# Chế độ 1 — local: mặc định tự trỏ <repo>/locksend-ai (không cần set DIR)
# LOCKSEND_AI_DIR=

# Chế độ 2 — host riêng Ubuntu: set URL (backend Railway không cần numpy/sklearn)
# LOCKSEND_AI_URL=http://10.0.0.5:8100
# LOCKSEND_AI_API_KEY=your-shared-secret
# LOCKSEND_AI_TIMEOUT=30
# Batch chờ lâu hơn single vì lần chạy nguội phải đợi AI nạp model ~95MB
# LOCKSEND_AI_BATCH_TIMEOUT=120
# Batch lỗi → chỉ gọi lẻ từng token (có SHAP, ~1s/token) khi số token <= ngưỡng này
# LOCKSEND_AI_FALLBACK_MAX_TOKENS=20
# LOCKSEND_AI_FALLBACK_CONCURRENCY=8
# LOCKSEND_AI_REALTIME_ENABLED=false
# LOCKSEND_AI_REALTIME_DEBOUNCE=300
# LOCKSEND_AI_REALTIME_MIN_AI=50

# ── VirusTotal (tra hash SHA-256 sau giải mã — client gửi hash, không gửi file) ──
# VIRUSTOTAL_API_KEY=
# VIRUSTOTAL_ENABLED=true
# VIRUSTOTAL_TIMEOUT=30

# ── Gemini trợ lý (system prompt + tài liệu LockSend, không fine-tune) ─────────
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_ENABLED=true
# GEMINI_TIMEOUT=60

# ── Cảnh báo owner + hết hạn keypair ─────────────────────────────────────────
# MULTI_IP_ALERT_THRESHOLD=3
# MULTI_IP_ALERT_WINDOW_DAYS=7
# KEYPAIR_LIFETIME_DAYS=365
# KEYPAIR_EXPIRY_WARN_DAYS=30

# ── Google Sign-In (Đăng nhập bằng Google) ────────────────────────────────────
# Tạo OAuth 2.0 Client ID tại: https://console.cloud.google.com/apis/credentials
# Loại: Web application
# Authorized JavaScript origins: http://localhost:5173, https://your-fe.up.railway.app
# GOOGLE_OAUTH_ENABLED=true
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# ── Xác minh email (OTP 6 số gửi qua Gmail) ───────────────────────────────────
# EMAIL_VERIFICATION_ENABLED=true
# EMAIL_OTP_EXPIRE_MINUTES=15
# EMAIL_OTP_RESEND_COOLDOWN_SEC=60

# ── Gmail Email Notifications ─────────────────────────────────────────────────
# Gửi email cảnh báo bảo mật đến email người dùng khi có alert mới.
# EMAIL_ENABLED=false
# EMAIL_BACKEND=gmail_apppassword          # gmail_apppassword | gmail_oauth2

# Backend 1 — Gmail App Password (đơn giản, khuyến nghị cho hầu hết setup)
# Bật "App Passwords" tại: https://myaccount.google.com/apppasswords
# (Yêu cầu tài khoản Google có bật xác thực 2 bước)
# GMAIL_USER=your-account@gmail.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# GMAIL_FROM=your-account@gmail.com

# Backend 2 — Gmail OAuth2 / XOAUTH2 (bảo mật hơn cho production)
# Tạo OAuth2 credentials tại: https://console.cloud.google.com/
# Scope cần thiết: https://mail.google.com/
# Cần cài thêm: pip install google-auth
# GMAIL_CLIENT_ID=xxx.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=GOCSPX-xxx
# GMAIL_REFRESH_TOKEN=1//xxx
# GMAIL_FROM=your-account@gmail.com

# ── OWASP A07 — Brute-force login lockout ─────────────────────────────────────
# Số lần thất bại tối đa trước khi khoá tài khoản (mặc định 5)
# LOGIN_MAX_ATTEMPTS=5
# Cửa sổ theo dõi (giây, mặc định 300 = 5 phút)
# LOGIN_LOCKOUT_WINDOW=300
# Thời gian khoá (giây, mặc định 900 = 15 phút)
# LOGIN_LOCKOUT_DURATION=900

# ── OWASP A04 — Download rate limiting ────────────────────────────────────────
# Số lần tải file tối đa mỗi (recipient × file) trong cửa sổ giờ (mặc định 10)
# DOWNLOAD_MAX_PER_RECIPIENT=10
# Cửa sổ đo (giờ, mặc định 1)
# DOWNLOAD_RATE_WINDOW=1

# ── OWASP A05 — Security Headers (CSP override) ────────────────────────────────
# Để trống = dùng CSP mặc định. Chỉ override nếu thực sự cần.
# CSP_POLICY=default-src 'self'; script-src 'self'; ...

# ── Token Security (rule engine) ──────────────────────────────────────────────
# Dọn log tự động mỗi TOKEN_CLEANUP_INTERVAL_DAYS (mặc định 7 ngày) khi backend chạy
TOKEN_CLEANUP_SCHEDULE_ENABLED=true
TOKEN_CLEANUP_INTERVAL_DAYS=7
TOKEN_CLEANUP_STARTUP_DELAY_SEC=120
TOKEN_CLEANUP_VACUUM=true
TOKEN_ACCESS_LOG_RETENTION_DAYS=14
TOKEN_SAS_RECORD_RETENTION_DAYS=30
TOKEN_SECURITY_JWT_MAX_SESSIONS=5
TOKEN_SECURITY_JWT_MAX_IPS=3
TOKEN_SECURITY_SAS_MAX_IPS=3
TOKEN_SECURITY_SAS_MAX_ACCESSES_PER_HOUR=30
TOKEN_SECURITY_SAS_MAX_AGE_HOURS=48
TOKEN_SECURITY_AUTO_REVOKE_SCORE=80
